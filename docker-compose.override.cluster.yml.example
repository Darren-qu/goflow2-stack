# Example only — NOT used by default install/deploy.
#
# Minimal sketch of ClickHouse Keeper + 2 shard × 2 replica naming.
# This does NOT replace production planning (networking, backups, upgrades).
#
# When to leave single-node compose:
#   - sustained tens of thousands of flow records/sec, or
#   - ClickHouse disk persistently > ~70%, or
#   - you need cross-host HA for raw flows
#
# Usage idea (advanced):
#   1. Study clickhouse/cluster/README.md
#   2. Adapt images/volumes/networks to your hosts
#   3. Change table engines to ReplicatedMergeTree + Distributed
#   4. Never point install.sh at this file blindly
#
# Default stack remains: docker-compose.yml (single ClickHouse).

services:
  # --- Keeper (coordination). Production often uses 3 nodes. ---
  ch-keeper-1:
    image: clickhouse/clickhouse-keeper:25.11-alpine
    profiles: ["cluster-example"]
    restart: unless-stopped
    # volumes / keeper config omitted — see clickhouse/cluster/README.md

  # --- Data nodes (names illustrate shard/replica layout) ---
  # shard1-replica1, shard1-replica2, shard2-replica1, shard2-replica2
  ch-s1r1:
    image: clickhouse/clickhouse-server:25.11-alpine
    profiles: ["cluster-example"]
    depends_on: [ch-keeper-1]
    environment:
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-flow}
    # profiles keep `docker compose up` from starting these by accident

  ch-s1r2:
    image: clickhouse/clickhouse-server:25.11-alpine
    profiles: ["cluster-example"]
    depends_on: [ch-keeper-1]
    environment:
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-flow}

  ch-s2r1:
    image: clickhouse/clickhouse-server:25.11-alpine
    profiles: ["cluster-example"]
    depends_on: [ch-keeper-1]
    environment:
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-flow}

  ch-s2r2:
    image: clickhouse/clickhouse-server:25.11-alpine
    profiles: ["cluster-example"]
    depends_on: [ch-keeper-1]
    environment:
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-flow}
