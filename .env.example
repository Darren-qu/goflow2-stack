# Local overrides — copy and edit (never commit .env):
#   cp .env.example .env

# Grafana admin (only applied on first Grafana volume bootstrap)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port for Grafana UI (container still listens on 3000)
GRAFANA_HOST_PORT=3030

# ClickHouse default user password (first volume init only;
# changing later requires resetting the ch_data volume + matching this value)
CLICKHOUSE_PASSWORD=flow

# Read-only ClickHouse account that Grafana queries with (applied on every
# db start; after changing it: docker compose up -d --force-recreate db grafana)
CLICKHOUSE_GRAFANA_PASSWORD=grafana-ro

# Share of host RAM ClickHouse may use. 0.6 suits a single host shared with
# Kafka/Grafana/Prometheus; raise towards 0.9 on a dedicated ClickHouse host.
CH_MEMORY_RATIO=0.6

# Prometheus (self-metrics + alert rules) history
PROMETHEUS_RETENTION=30d

# Flow data retention (applied by clickhouse/apply_retention.sh on deploy)
# Detail rows grow fast; aggregates stay longer for trends.
FLOWS_RAW_TTL_DAYS=30
FLOWS_5M_TTL_DAYS=180

# Kafka is only a buffer before ClickHouse (hours, not weeks)
KAFKA_LOG_RETENTION_HOURS=48

# Ingestion parallelism (only takes effect on a fresh topic / fresh ClickHouse
# volume — see README "Scaling ingestion" for changing an existing install).
KAFKA_NUM_PARTITIONS=3
CH_KAFKA_NUM_CONSUMERS=3
