# Local overrides — copy and edit (never commit .env):
#   cp .env.example .env

# Grafana admin (only applied on first Grafana volume bootstrap)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port for Grafana UI (container still listens on 3000)
GRAFANA_HOST_PORT=3030

# ClickHouse default user password (first volume init only;
# changing later requires resetting the ch_data volume + matching this value)
CLICKHOUSE_PASSWORD=flow

# Flow data retention (applied by clickhouse/apply_retention.sh on deploy)
# Detail rows grow fast; aggregates stay longer for trends.
FLOWS_RAW_TTL_DAYS=30
FLOWS_5M_TTL_DAYS=180

# Kafka is only a buffer before ClickHouse (hours, not weeks)
KAFKA_LOG_RETENTION_HOURS=48
