{
  "annotations": {
    "list": []
  },
  "description": "Host + pipeline health for the goflow2-stack server: load/memory/disk (via ClickHouse's own asynchronous_metrics — no node_exporter needed), whether the Kafka engine is actually consuming, whether goflow2 is receiving flow packets, and Prometheus scrape target status.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "ClickHouseAsyncMetrics_LoadAverage1", "refId": "A" }
      ],
      "title": "Load Average (1m)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100*(1-ClickHouseAsyncMetrics_OSMemoryAvailable/ClickHouseAsyncMetrics_OSMemoryTotal)",
          "refId": "A"
        }
      ],
      "title": "Memory Used",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100*ClickHouseAsyncMetrics_DiskAvailable_default/(ClickHouseAsyncMetrics_DiskAvailable_default+ClickHouseAsyncMetrics_DiskUsed_default)",
          "refId": "A"
        }
      ],
      "title": "Disk Free (matches DiskSpaceLow alert)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "ClickHouseAsyncMetrics_OSUptime", "refId": "A" }
      ],
      "title": "Host Uptime",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "ClickHouseMetrics_KafkaConsumersWithAssignment",
          "legendFormat": "assigned",
          "refId": "A"
        }
      ],
      "title": "Kafka Consumers Assigned (of 3)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Count of Prometheus alerts currently firing from rules.yml (DiskSpaceLow, ClickHouseKafkaConsumptionStalled, GoflowCollectionStopped). No Alertmanager is wired up, so this panel and the Prometheus UI (127.0.0.1:9090/alerts) are the only places this surfaces.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(ALERTS{alertstate=\"firing\"}) OR vector(0)",
          "refId": "A"
        }
      ],
      "title": "Active Alerts",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "ClickHouseAsyncMetrics_LoadAverage1", "legendFormat": "1m", "refId": "A" },
        { "datasource": "Prometheus", "expr": "ClickHouseAsyncMetrics_LoadAverage5", "legendFormat": "5m", "refId": "B" },
        { "datasource": "Prometheus", "expr": "ClickHouseAsyncMetrics_LoadAverage15", "legendFormat": "15m", "refId": "C" }
      ],
      "title": "Load Average",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100*(1-ClickHouseAsyncMetrics_OSMemoryAvailable/ClickHouseAsyncMetrics_OSMemoryTotal)",
          "legendFormat": "used",
          "refId": "A"
        }
      ],
      "title": "Memory Used",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100*ClickHouseAsyncMetrics_DiskAvailable_default/(ClickHouseAsyncMetrics_DiskAvailable_default+ClickHouseAsyncMetrics_DiskUsed_default)",
          "legendFormat": "free",
          "refId": "A"
        }
      ],
      "title": "Disk Free",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "This is exactly what stalled silently on 2026-08-20: process healthy, port listening, but this rate dropped to 0 and nothing was consuming from Kafka into ClickHouse.",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(ClickHouseProfileEvents_KafkaMessagesRead[5m])",
          "legendFormat": "messages/sec",
          "refId": "A"
        }
      ],
      "title": "ClickHouse Kafka Consumption Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Zero here means the exporter/device stopped sending — independent of the ClickHouse-side panel to the left.",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "pps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(goflow2_flow_traffic_packets_total[5m]))",
          "legendFormat": "packets/sec",
          "refId": "A"
        }
      ],
      "title": "goflow2 Collection Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "id": 12,
      "options": {
        "showHeader": true
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "up", "format": "table", "instant": true, "refId": "A" }
      ],
      "title": "Prometheus Scrape Targets",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ops", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Server Status",
  "uid": "server-status",
  "version": 1,
  "weekStart": ""
}
