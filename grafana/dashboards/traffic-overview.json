          "query": "SELECT\n  multiIf(\n    proto = 6, 'TCP',\n    proto = 17, 'UDP',\n    proto = 1, 'ICMP',\n    proto = 58, 'ICMPv6',\n    proto = 47, 'GRE',\n    ifNull(nullIf(dictGetString('dictionaries.protocols', 'name', toUInt64(proto)), ''), concat('Other(', toString(proto), ')'))\n  ) AS protocol,\n  sum(bytes_norm) AS traffic\nFROM $table\nWHERE $timeFilter\n  AND (\n    ${scope:singlequote} = 'all'\n    OR (etype = 2048 AND ${scope:singlequote} = 'ew' AND isRfc1918OrCgnat(src_addr) AND isRfc1918OrCgnat(dst_addr))\n    OR (etype = 2048 AND ${scope:singlequote} = 'ns' AND isRfc1918OrCgnat(src_addr) != isRfc1918OrCgnat(dst_addr))\n  )\nGROUP BY protocol\nORDER BY traffic DESC",
          "refId": "A",
