          "query": "SELECT t, sum(bytes_total) AS bytes_total\nFROM (\n  SELECT $timeSeries AS t, sum(bytes_norm) AS bytes_total\n  FROM $table\n  WHERE $timeFilter\n    AND (\n    ${scope:singlequote} = 'all'\n    OR (etype = 2048 AND ${scope:singlequote} = 'ew' AND isRfc1918OrCgnat(src_addr) AND isRfc1918OrCgnat(dst_addr))\n    OR (etype = 2048 AND ${scope:singlequote} = 'ns' AND isRfc1918OrCgnat(src_addr) != isRfc1918OrCgnat(dst_addr))\n  )\n  GROUP BY t\n  UNION ALL\n  SELECT toInt64(intDiv($from + number * $interval, $interval) * $interval * 1000) AS t, 0 AS bytes_total\n  FROM numbers(intDiv($to - $from, $interval))\n)\nGROUP BY t ORDER BY t",
