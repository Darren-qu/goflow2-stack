      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT uniqExact(src_addr) AS srcs FROM $table WHERE $timeFilter",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Unique Sources",
      "type": "stat"
    },
    {
      "datasource": "ClickHouse",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "area",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "time_series",
          "query": "SELECT t, sum(sumbytes) AS sumbytes\nFROM (\n  SELECT $timeSeries AS t, sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS sumbytes\n  FROM $table WHERE $timeFilter GROUP BY t\n  UNION ALL\n  SELECT toInt64(intDiv($from + number * $interval, $interval) * $interval * 1000) AS t, 0 AS sumbytes\n  FROM numbers(intDiv($to - $from, $interval))\n)\nGROUP BY t ORDER BY t",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Traffic Trend",
      "type": "timeseries"
    },
    {
      "datasource": "ClickHouse",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "decbytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "id": 31,
      "options": {
        "displayLabels": ["percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "pieType": "donut",
        "reduceOptions": { "calcs": [], "fields": "", "values": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n  multiIf(\n    proto = 6, 'TCP',\n    proto = 17, 'UDP',\n    proto = 1, 'ICMP',\n    proto = 58, 'ICMPv6',\n    proto = 47, 'GRE',\n    ifNull(nullIf(dictGetString('dictionaries.protocols', 'name', toUInt64(proto)), ''), concat('Other(', toString(proto), ')'))\n  ) AS protocol,\n  sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic\nFROM $table\nWHERE $timeFilter\nGROUP BY protocol\nORDER BY traffic DESC",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Protocols",
      "type": "piechart"
    },
    {
      "datasource": "ClickHouse",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "src_ip" },
            "properties": [
              { "id": "displayName", "value": "Source IP" },
              { "id": "custom.width", "value": 150 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "traffic" },
            "properties": [
              { "id": "unit", "value": "decbytes" },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "gauge", "valueDisplayMode": "text" }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 12 },
      "id": 20,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "traffic" }]
      },
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n  if(etype = 2048, IPv4NumToString(reinterpretAsUInt32(substring(reverse(src_addr), 13, 4))), IPv6NumToString(src_addr)) AS src_ip,\n  sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic\nFROM $table\nWHERE $timeFilter\nGROUP BY src_ip\nORDER BY traffic DESC\nLIMIT 10",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Top Sources",
      "type": "table"
    },
    {
      "datasource": "ClickHouse",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dst_ip" },
            "properties": [
              { "id": "displayName", "value": "Dest IP" },
              { "id": "custom.width", "value": 150 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "traffic" },
            "properties": [
              { "id": "unit", "value": "decbytes" },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "gauge", "valueDisplayMode": "text" }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 12 },
      "id": 21,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "traffic" }]
      },
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n  if(etype = 2048, IPv4NumToString(reinterpretAsUInt32(substring(reverse(dst_addr), 13, 4))), IPv6NumToString(dst_addr)) AS dst_ip,\n  sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic\nFROM $table\nWHERE $timeFilter\nGROUP BY dst_ip\nORDER BY traffic DESC\nLIMIT 10",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Top Destinations",
      "type": "table"
    },
    {
      "datasource": "ClickHouse",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "service" },
            "properties": [{ "id": "displayName", "value": "Service" }]
          },
          {
            "matcher": { "id": "byName", "options": "traffic" },
            "properties": [
              { "id": "unit", "value": "decbytes" },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "gauge", "valueDisplayMode": "text" }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 12 },
      "id": 30,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "traffic" }]
      },
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n  concat(\n    multiIf(proto = 6, 'TCP', proto = 17, 'UDP', proto = 1, 'ICMP', toString(proto)),\n    '/',\n    toString(dst_port)\n  ) AS service,\n  sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic\nFROM $table\nWHERE $timeFilter\nGROUP BY service\nORDER BY traffic DESC\nLIMIT 10",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Top Services",
      "type": "table"
    }
  ],
