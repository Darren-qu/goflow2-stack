        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n  concat(\n    ifNull(nullIf(dictGetString('dictionaries.protocols', 'name', toUInt64(proto)), ''), toString(proto)),\n    '/',\n    multiIf(\n      nullIf(dictGetString('dictionaries.services', 'name', toUInt64(dst_port)), '') != '', dictGetString('dictionaries.services', 'name', toUInt64(dst_port)),\n      nullIf(dictGetString('dictionaries.services', 'name', toUInt64(src_port)), '') != '', dictGetString('dictionaries.services', 'name', toUInt64(src_port)),\n      dst_port > 0 AND dst_port < 1024, concat('port-', toString(dst_port)),\n      src_port > 0 AND src_port < 1024, concat('port-', toString(src_port)),\n      concat('port-', toString(if(dst_port > 0, dst_port, src_port)))\n    )\n  ) AS service,\n  sum(bytes_norm) AS traffic\nFROM $table\nWHERE $timeFilter\n  AND (\n    ${scope:singlequote} = 'all'\n    OR (etype = 2048 AND ${scope:singlequote} = 'ew' AND isRfc1918OrCgnat(src_addr) AND isRfc1918OrCgnat(dst_addr))\n    OR (etype = 2048 AND ${scope:singlequote} = 'ns' AND isRfc1918OrCgnat(src_addr) != isRfc1918OrCgnat(dst_addr))\n  )\nGROUP BY service\nORDER BY traffic DESC\nLIMIT toUInt64OrZero(${topn:singlequote})",
