            "sum"
          ],
          "fields": "traffic",
          "countRows": false
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "traffic"
          }
        ]
      },
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n    country,\n    sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic,\n    count() AS flows,\n    uniqExact(ip) AS public_ips\nFROM\n(\n    SELECT\n        bytes,\n        sampling_rate,\n        ip,\n        dictGet('geoip_trie', 'country_code', ip) AS country\n    FROM\n    (\n        SELECT\n            bytes,\n            sampling_rate,\n            reinterpretAsUInt32(substring(reverse(if(${direction:singlequote} = 'src_addr', src_addr, dst_addr)), 13, 4)) AS ip\n        FROM $table\n        WHERE $timeFilter\n          AND etype = 2048\n          AND NOT isNonRoutable(if(${direction:singlequote} = 'src_addr', src_addr, dst_addr))\n    )\n)\nWHERE country != ''\nGROUP BY country\nORDER BY traffic DESC\nLIMIT toUInt64OrZero(${topn:singlequote})",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Top countries",
      "type": "table",
      "description": "Countries for mapped public IPs. Rows = Top N (default 8)."
