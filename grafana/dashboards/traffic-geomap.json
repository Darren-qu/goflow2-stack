      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n    IPv4NumToString(ip) AS public_ip,\n    country,\n    city,\n    sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic,\n    count() AS flows\nFROM\n(\n    SELECT\n        bytes,\n        sampling_rate,\n        ip,\n        dictGet('geoip_trie', 'country_code', ip) AS country,\n        dictGet('geoip_trie', 'city', ip) AS city\n    FROM\n    (\n        SELECT\n            bytes,\n            sampling_rate,\n            reinterpretAsUInt32(substring(reverse(if(${direction:singlequote} = 'src_addr', src_addr, dst_addr)), 13, 4)) AS ip\n        FROM $table\n        WHERE $timeFilter\n          AND etype = 2048\n          AND NOT isNonRoutable(if(${direction:singlequote} = 'src_addr', src_addr, dst_addr))\n    )\n)\nWHERE country != ''\nGROUP BY public_ip, country, city\nORDER BY traffic DESC\nLIMIT toUInt64OrZero(${topn:singlequote})",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "Top public IPs",
      "type": "table",
