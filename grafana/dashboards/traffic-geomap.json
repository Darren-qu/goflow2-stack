            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "name": "Public IPs",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "id": "coords",
          "lat": 20,
          "lon": 0,
          "zoom": 1.5,
          "allLayers": false,
          "padding": 0
        }
      },
      "pluginVersion": "12.1.0",
      "targets": [
        {
          "database": "default",
          "dateColDataType": "date",
          "dateTimeColDataType": "time_received_ns",
          "dateTimeType": "DATETIME64",
          "format": "table",
          "query": "SELECT\n    latitude,\n    longitude,\n    if(city = '', country, concat(country, ' / ', city)) AS place,\n    sum(bytes * if(sampling_rate = 0, 1, sampling_rate)) AS traffic,\n    count() AS flows\nFROM\n(\n    SELECT\n        bytes,\n        sampling_rate,\n        dictGet('geoip_trie', 'latitude', ip) AS latitude,\n        dictGet('geoip_trie', 'longitude', ip) AS longitude,\n        dictGet('geoip_trie', 'country_code', ip) AS country,\n        dictGet('geoip_trie', 'city', ip) AS city\n    FROM\n    (\n        SELECT\n            bytes,\n            sampling_rate,\n            reinterpretAsUInt32(substring(reverse(if(${direction:singlequote} = 'src_addr', src_addr, dst_addr)), 13, 4)) AS ip\n        FROM $table\n        WHERE $timeFilter\n          AND etype = 2048\n          AND NOT isNonRoutable(if(${direction:singlequote} = 'src_addr', src_addr, dst_addr))\n    )\n)\nWHERE (latitude != 0 OR longitude != 0) AND country != ''\nGROUP BY latitude, longitude, place\nORDER BY traffic DESC\nLIMIT 400",
          "refId": "A",
          "table": "flows_raw"
        }
      ],
      "title": "World map (${direction:text})",
      "type": "geomap"
    },
