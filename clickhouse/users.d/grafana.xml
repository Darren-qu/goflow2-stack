<clickhouse>
    <!-- Read-only account for Grafana, so nobody with dashboard-edit rights can
         alter or drop tables. readonly=2: SELECT only, but query-level settings
         may still be sent (the Grafana plugin needs that). Password comes from
         CLICKHOUSE_GRAFANA_PASSWORD in .env; unlike the default user it is read
         on every start, so it can be changed later with a db restart. -->
    <profiles>
        <grafana_ro>
            <readonly>2</readonly>
            <!-- Keep dashboards from starving ingestion: a 7-day IP lookup with
                 30 s auto-refresh once pinned all 4 cores (2026-11-26). Each panel
                 query gets at most 8 threads (sized for the 32-vCPU host: about
                 a quarter of the cores) and 60 s; at most 8 Grafana queries
                 run at once (a dashboard's panels), and queries whose HTTP client
                 went away (refresh, closed tab) are cancelled. -->
            <max_execution_time>60</max_execution_time>
            <max_threads>8</max_threads>
            <max_concurrent_queries_for_user>8</max_concurrent_queries_for_user>
            <cancel_http_readonly_queries_on_client_close>1</cancel_http_readonly_queries_on_client_close>
            <constraints>
                <max_execution_time><max>60</max></max_execution_time>
                <max_threads><max>8</max></max_threads>
            </constraints>
        </grafana_ro>
    </profiles>
    <users>
        <grafana>
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD" />
            <profile>grafana_ro</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
        </grafana>
    </users>
</clickhouse>
